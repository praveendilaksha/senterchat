# Server Configuration
PORT=3000

# OpenRouter / Gemini API Key
GEMINI_API_KEY=your_openrouter_or_gemini_api_key_here
GEMINI_MODEL=google/gemini-2.5-flash

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:3000,https://sentermusicfestival.com,https://www.sentermusicfestival.com,https://senterfest.com
